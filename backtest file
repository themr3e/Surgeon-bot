// Simulate the strategy on a single symbol using pre-fetched candle arrays.
// Walk-forward: computes all indicators once, then iterates candle by candle.
//
// TP/SL check on each candle: uses candle High/Low to determine if hit.
// If both SL and TP are hit within the same candle → SL assumed (conservative).
//
// Returns a result object with performance metrics.
function simulateSymbol(symbol, recordsM15, recordsH4) {
    var n15 = recordsM15.length;
    var n4  = recordsH4.length;
    var ERR = { symbol: symbol, netPnl: 0, trades: 0, wins: 0, losses: 0,
                winPct: 0, profitFactor: 0, maxDD: 0, balance: INITIAL_CAPITAL };

    if (n15 < 310 || n4 < 210) {
        ERR.error = "Not enough data (M15:" + n15 + " H4:" + n4 + ")";
        return ERR;
    }

    // ── Pre-compute ALL M15 indicators (once, O(n)) ──
    var ema3_15    = TA.EMA(recordsM15, 3);
    var ema8_15    = TA.EMA(recordsM15, 8);
    var vwap_15    = calcVWAP(recordsM15);
    var atr_15     = calcATR(recordsM15, ATR_PERIOD);
    var adxRes_15  = calcADX(recordsM15, ADX_PERIOD);
    var adx_15     = adxRes_15.adx;
    var atrSMA_15  = calcSMA(atr_15, 20);

    // ── Pre-compute ALL H4 indicators (once, O(n)) ──
    var ema3_4    = TA.EMA(recordsH4, 3);
    var ema8_4    = TA.EMA(recordsH4, 8);
    var ema200_4  = TA.EMA(recordsH4, 200);

    // ── Simulation state ──
    var balance     = INITIAL_CAPITAL;
    var peakBal     = INITIAL_CAPITAL;
    var maxDD       = 0;
    var trades      = 0, wins = 0, losses = 0;
    var grossProfit = 0, grossLoss = 0;
    var totalPnl    = 0;
    var position    = null; // { dir, size, entry, tp, sl }

    // H4 pointer: advances alongside M15 timestamps
    var h4Ptr = 0;

    // ── Walk forward from M15 index 300 (warmup) ──
    for (var i = 300; i < n15 - 1; i++) {
        var curTime = recordsM15[i].Time;

        // Advance H4 pointer to the last H4 candle whose open time ≤ current M15 time
        while (h4Ptr + 1 < n4 && recordsH4[h4Ptr + 1].Time <= curTime) {
            h4Ptr++;
        }

        // Use h4Ptr-1 as the last FULLY CLOSED H4 candle
        var h4Idx = h4Ptr - 1;
        if (h4Idx < 200) continue; // need 200 bars for EMA200

        // H4 indicators
        var h4e3   = ema3_4[h4Idx];
        var h4e8   = ema8_4[h4Idx];
        var h4e200 = ema200_4[h4Idx];
        if (isNaN(h4e3) || isNaN(h4e8) || isNaN(h4e200)) continue;

        var h4Close = recordsH4[h4Idx].Close;
        var h4Bias;
        if      (h4e3 > h4e8 && h4Close > h4e200) h4Bias = "BULL";
        else if (h4e3 < h4e8 && h4Close < h4e200) h4Bias = "BEAR";
        else                                        h4Bias = "NEUTRAL";

        // ── Check open position TP/SL ──
        if (position !== null) {
            var candle = recordsM15[i];
            var closed = false, closePx = 0, win = false;

            if (position.dir === "LONG") {
                // Conservative: SL takes priority if both hit same candle
                if (candle.Low <= position.sl) {
                    closed = true; closePx = position.sl; win = false;
                } else if (candle.High >= position.tp) {
                    closed = true; closePx = position.tp; win = true;
                }
            } else { // SHORT
                if (candle.High >= position.sl) {
                    closed = true; closePx = position.sl; win = false;
                } else if (candle.Low <= position.tp) {
                    closed = true; closePx = position.tp; win = true;
                }
            }

            if (closed) {
                var pnl = position.dir === "LONG"
                    ? (closePx - position.entry) * position.size
                    : (position.entry - closePx) * position.size;

                balance  += pnl;
                totalPnl += pnl;
                trades++;

                if (win) { wins++; grossProfit += pnl; }
                else     { losses++; grossLoss  += Math.abs(pnl); }

                if (balance > peakBal) peakBal = balance;
                var dd = (peakBal - balance) / peakBal;
                if (dd > maxDD) maxDD = dd;

                position = null;
            }
            // Never open a new trade on the same candle we close (one trade at a time)
            continue;
        }

        // ── Check M15 entry conditions ──
        var e3c = ema3_15[i],   e3p = ema3_15[i-1];
        var e8c = ema8_15[i],   e8p = ema8_15[i-1];
        var vwap   = vwap_15[i];
        var atr    = atr_15[i];
        var atrSMA = atrSMA_15[i];
        var adxV   = adx_15[i];

        if (isNaN(e3c) || isNaN(e3p) || isNaN(e8c) || isNaN(e8p)) continue;
        if (isNaN(vwap) || isNaN(atr) || isNaN(atrSMA) || isNaN(adxV)) continue;
        if (atr <= 0) continue;

        var close = recordsM15[i].Close;

        var crossUp   = (e3p <= e8p) && (e3c > e8c);
        var crossDown = (e3p >= e8p) && (e3c < e8c);
        var adxOk     = adxV > ADX_MIN;
        var atrSpike  = atr > atrSMA;

        var signal = null;
        if (h4Bias === "BULL" && crossUp   && close > vwap && adxOk && atrSpike) signal = "LONG";
        if (h4Bias === "BEAR" && crossDown && close < vwap && adxOk && atrSpike) signal = "SHORT";

        if (signal === null) continue;

        // Enter at next candle's open price (realistic fill)
        var entryPrice = recordsM15[i+1].Open;
        var slDist     = ATR_SL_MULT * atr;
        var tpDist     = ATR_TP_MULT * atr;
        var riskUsd    = balance * RISK_PER_TRADE;
        var size       = riskUsd / slDist;

        if (size <= 0 || slDist <= 0) continue;

        position = {
            dir:   signal,
            size:  size,
            entry: entryPrice,
            tp:    signal === "LONG" ? entryPrice + tpDist : entryPrice - tpDist,
            sl:    signal === "LONG" ? entryPrice - slDist : entryPrice + slDist
        };
    }

    var profitFactor = grossLoss > 0
        ? grossProfit / grossLoss
        : (grossProfit > 0 ? 999.0 : 0.0);

    return {
        symbol:       symbol,
        netPnl:       totalPnl,
        balance:      balance,
        trades:       trades,
        wins:         wins,
        losses:       losses,
        winPct:       trades > 0 ? wins / trades * 100 : 0,
        profitFactor: profitFactor,
        maxDD:        maxDD * 100
    };
}

// Run backtest on all 20 symbols and print a ranked results table
function runMultiSymbolBacktest() {
    Log("+============================================================+");
    Log("|   THE SURGEON BOT v2 — MULTI-SYMBOL BACKTEST              |");
    Log("|   Strategy: EMA3/8 Cross (M15+H4) + ADX + ATR SL/TP      |");
    Log("+============================================================+");
    Log("|  Capital per symbol : $" + INITIAL_CAPITAL);
    Log("|  Risk per trade     : " + (RISK_PER_TRADE * 100) + "%");
    Log("|  SL                 : " + ATR_SL_MULT + "× ATR");
    Log("|  TP                 : " + ATR_TP_MULT + "× ATR  (R:R 2:1)");
    Log("|  Min ADX            : " + ADX_MIN);
    Log("|  Symbols            : " + BACKTEST_SYMBOLS.length);
    Log("+============================================================+\n");

    var results = [];

    for (var s = 0; s < BACKTEST_SYMBOLS.length; s++) {
        var sym = BACKTEST_SYMBOLS[s];
        Log("[" + (s+1) + "/" + BACKTEST_SYMBOLS.length + "] Fetching data for " + sym + "...");

        try {
            exchange.IO("currency", sym);
            exchange.SetContractType("swap");
            Sleep(600); // small delay to avoid API rate limit

            var rM15 = exchange.GetRecords(PERIOD_M15);
            var rH4  = exchange.GetRecords(PERIOD_H4);

            if (!rM15 || !rH4) {
                Log("[WARN] No data returned for " + sym);
                results.push({ symbol: sym, netPnl: 0, trades: 0, wins: 0, losses: 0,
                    winPct: 0, profitFactor: 0, maxDD: 0, balance: INITIAL_CAPITAL,
                    error: "No data" });
                continue;
            }

            Log("       Simulating " + rM15.length + " M15 + " + rH4.length + " H4 candles...");
            var res = simulateSymbol(sym, rM15, rH4);
            results.push(res);

            if (res.error) {
                Log("       [SKIP] " + res.error);
            } else {
                Log("       Done — PnL: " + signStr(res.netPnl) + "$" + res.netPnl.toFixed(2) +
                    " | Trades: " + res.trades +
                    " | Win%: " + res.winPct.toFixed(1) + "%");
            }

        } catch (e) {
            Log("[ERROR] " + sym + ": " + (e.message || e));
            results.push({ symbol: sym, netPnl: 0, trades: 0, wins: 0, losses: 0,
                winPct: 0, profitFactor: 0, maxDD: 0, balance: INITIAL_CAPITAL,
                error: String(e.message || e).slice(0, 50) });
        }

        Sleep(400);
    }

    // Sort by net PnL descending (best → worst)
    results.sort(function(a, b) { return b.netPnl - a.netPnl; });

    // ── Print ranked results table ──
    Log("\n");
    Log("+====+===============+============+========+======+=========+=======+");
    Log("| #  | Symbol        | Net PnL    | Win %  | P.F. | Max DD% | Trades|");
    Log("+====+===============+============+========+======+=========+=======+");

    for (var r = 0; r < results.length; r++) {
        var res  = results[r];
        var rank = padStr(String(r + 1), 2);
        var sym  = padStr(res.symbol, 13);

        if (res.error && res.trades === 0) {
            Log("| " + rank + " | " + sym + " | ERROR: " + String(res.error).slice(0, 45));
            continue;
        }

        var pnlStr = padStr(signStr(res.netPnl) + "$" + res.netPnl.toFixed(2), 10);
        var winStr = padStr(res.winPct.toFixed(1) + "%", 6);
        var pfStr  = padStr(res.profitFactor >= 999 ? "inf" : res.profitFactor.toFixed(2), 4);
        var ddStr  = padStr(res.maxDD.toFixed(1) + "%", 7);
        var trStr  = padStr(String(res.trades), 5);

        Log("| " + rank + " | " + sym + " | " + pnlStr +
            " | " + winStr + " | " + pfStr + " | " + ddStr + " | " + trStr + " |");
    }

    Log("+====+===============+============+========+======+=========+=======+");

    // Summary row
    var totalPnl    = 0, totalTrades = 0;
    var totalWins   = 0, totalLosses = 0;
    var totalGP     = 0, totalGL     = 0;
    for (var r = 0; r < results.length; r++) {
        totalPnl    += results[r].netPnl;
        totalTrades += results[r].trades;
        totalWins   += results[r].wins;
        totalLosses += results[r].losses;
    }
    var overallWin = totalTrades > 0 ? totalWins / totalTrades * 100 : 0;

    Log("\n[SUMMARY] Combined PnL  : " + signStr(totalPnl) + "$" + totalPnl.toFixed(2));
    Log("[SUMMARY] Total Trades  : " + totalTrades);
    Log("[SUMMARY] Overall Win % : " + overallWin.toFixed(1) + "%");
    Log("[SUMMARY] Best Symbol   : " + results[0].symbol +
        " (" + signStr(results[0].netPnl) + "$" + results[0].netPnl.toFixed(2) + ")");
    Log("[SUMMARY] Worst Symbol  : " + results[results.length-1].symbol +
        " (" + signStr(results[results.length-1].netPnl) + "$" + results[results.length-1].netPnl.toFixed(2) + ")");
    Log("\n[DONE] Backtest complete.");
}

// =====================================================================
// MAIN ENTRY POINT
// =====================================================================

function main() {
    Log("+====================================================+");
    Log("|   THE SURGEON BOT v2 — FMZ QUANT                  |");
    Log("|   EMA3/8 Dual-TF + ADX + ATR SL/TP                |");
    Log("+====================================================+");
    Log("|  Mode     : " + (LIVE_MODE ? "LIVE TRADING on " + LIVE_SYMBOL : "MULTI-SYMBOL BACKTEST"));
    Log("|  SL / TP  : " + ATR_SL_MULT + "× ATR / " + ATR_TP_MULT + "× ATR");
    Log("|  Risk     : " + (RISK_PER_TRADE * 100) + "% | Max DD: " + (MAX_DD_PCT * 100) + "%");
    Log("+====================================================+");

    // ── BACKTEST MODE ─────────────────────────────────────────────
    if (!LIVE_MODE) {
        Log("[INFO] LIVE_MODE = false → Running multi-symbol backtest simulation.");
        Log("[INFO] Note: symbol switching requires running in FMZ 'Live' tab,");
        Log("[INFO] not the 'Backtest' tab (backtest locks to one symbol).");
        runMultiSymbolBacktest();
        return;
    }

    // ── LIVE TRADING MODE ─────────────────────────────────────────
    exchange.IO("currency", LIVE_SYMBOL);
    exchange.SetContractType("swap");

    // Read actual balance from exchange
    var account = exchange.GetAccount();
    if (account) {
        liveBalance = (account.Balance || 0) + (account.FrozenBalance || 0);
        if (liveBalance <= 0) liveBalance = INITIAL_CAPITAL;
    }
    peakBalance = liveBalance;
    Log("[CONNECT] Balance: $" + liveBalance.toFixed(2) + " | Symbol: " + LIVE_SYMBOL);

    // Main loop
    while (true) {

        // ── Cooldown check ──────────────────────────────────────
        if (cooldownUntil > 0 && Date.now() < cooldownUntil) {
            var remH = ((cooldownUntil - Date.now()) / 3600000).toFixed(1);
            Log("⏳ [COOLDOWN] Bot paused — " + remH + "h remaining.");
            Sleep(POLL_MS);
            continue;
        }

        // Notify when cooldown has just expired
        if (cooldownUntil > 0 && Date.now() >= cooldownUntil) {
            Log("✅ Cooldown ended — bot resumed trading.");
            cooldownUntil = 0;
            peakBalance   = liveBalance; // reset drawdown baseline after recovery
        }

        // ── Update balance ───────────────────────────────────────
        var acc = exchange.GetAccount();
        if (acc) liveBalance = (acc.Balance || 0) + (acc.FrozenBalance || 0);

        // ── Drawdown guard ───────────────────────────────────────
        if (checkDrawdown(liveBalance)) {
            Sleep(POLL_MS);
            continue;
        }

        // ── Fetch market data ────────────────────────────────────
        var recordsH4  = exchange.GetRecords(PERIOD_H4);
        var recordsM15 = exchange.GetRecords(PERIOD_M15);

        if (!recordsH4 || recordsH4.length < 203 || !recordsM15 || recordsM15.length < 60) {
            Log("[WARN] Not enough candle data — waiting...");
            Sleep(POLL_MS);
            continue;
        }

        // ── Compute indicators ───────────────────────────────────
        var h4Bias    = getH4Bias(recordsH4);
        var m15Result = checkM15Signal(recordsM15, h4Bias);
        var signal    = m15Result.signal;
        var atr       = m15Result.atr;
        var adx       = m15Result.adx;
        var vwap      = m15Result.vwap;
        var price     = getCurrentPrice();

        // ── Print dashboard ──────────────────────────────────────
        printDashboard(h4Bias, signal, adx, atr, vwap, price);

        // ── Trade logic ──────────────────────────────────────────
        if (!currentTrade) {
            if (signal) {
                Log("[SIGNAL] " + signal + " confirmed | H4: " + h4Bias +
                    " | ADX: " + adx.toFixed(1) +
                    " | ATR: $" + atr.toFixed(2));

                var ok = executeLiveTrade(signal, atr);
                if (ok) {
                    monitorLiveTrade(); // blocks until TP or SL hit
                } else {
                    Log("[WARN] Trade failed — will retry next cycle.");
                    Sleep(POLL_MS);
                }
            } else {
                Log("[SCAN] No signal | H4: " + h4Bias +
                    " | ADX: " + adx.toFixed(1) + " | Waiting...");
                Sleep(POLL_MS);
            }
        } else {
            // Resume monitoring after unexpected restart
            Log("[RESUME] Resuming existing trade monitor...");
            monitorLiveTrade();
        }
    }
}
