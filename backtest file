// =====================================================================
// UTILITY HELPERS
// =====================================================================

// Floor a number to N decimal places (avoid over-precision in order sizes)
function floorTo(value, decimals) {
    var f = Math.pow(10, decimals);
    return Math.floor(value * f) / f;
}

// Pad a string to a fixed width (for table alignment)
function padStr(str, width) {
    var s = String(str);
    while (s.length < width) s += " ";
    return s.slice(0, width);
}

// Format a number with leading sign (+/-)
function signStr(val) {
    return val >= 0 ? "+" : "";
}

// =====================================================================
// INDICATOR CALCULATIONS (all manual — no external libraries)
// =====================================================================

// ── VWAP ──
// Cumulative (ΣTypicalPrice×Volume) / ΣVolume, reset each UTC day
function calcVWAP(records) {
    var result = [];
    var cumTPV = 0, cumVol = 0, dayStart = -1;

    for (var i = 0; i < records.length; i++) {
        var r   = records[i];
        var tp  = (r.High + r.Low + r.Close) / 3;
        var day = Math.floor(r.Time / 86400000); // UTC day number

        // Reset at day boundary
        if (day !== dayStart) {
            cumTPV = 0;
            cumVol = 0;
            dayStart = day;
        }

        cumTPV += tp * r.Volume;
        cumVol += r.Volume;
        result.push(cumVol > 0 ? cumTPV / cumVol : tp);
    }
    return result;
}

// ── ATR (Average True Range) ──
// Uses Wilder smoothing: ATR[i] = (ATR[i-1] × (period-1) + TR[i]) / period
function calcATR(records, period) {
    var n      = records.length;
    var result = [];
    var trArr  = [];

    for (var i = 0; i < n; i++) {
        result.push(NaN);
        if (i === 0) {
            trArr.push(records[i].High - records[i].Low);
        } else {
            var hl = records[i].High - records[i].Low;
            var hc = Math.abs(records[i].High - records[i-1].Close);
            var lc = Math.abs(records[i].Low  - records[i-1].Close);
            trArr.push(Math.max(hl, hc, lc));
        }
    }

    if (n < period) return result;

    // First ATR = simple average of first `period` TR values
    var sum = 0;
    for (var j = 0; j < period; j++) sum += trArr[j];
    result[period - 1] = sum / period;

    // Wilder smoothing for the rest
    for (var k = period; k < n; k++) {
        result[k] = (result[k-1] * (period - 1) + trArr[k]) / period;
    }
    return result;
}

// ── ADX (Average Directional Index) ──
// Classic Wilder method: +DM, -DM, TR smoothed → +DI, -DI → DX → ADX
function calcADX(records, period) {
    var n = records.length;
    var adxArr    = [], plusDIArr = [], minusDIArr = [];
    for (var i = 0; i < n; i++) {
        adxArr.push(NaN); plusDIArr.push(NaN); minusDIArr.push(NaN);
    }

    if (n < period * 2 + 1) {
        return { adx: adxArr, plusDI: plusDIArr, minusDI: minusDIArr };
    }

    // Step 1: compute raw TR, +DM, -DM for each candle
    var trRaw  = [0];  // index 0 = placeholder
    var pDMRaw = [0];
    var mDMRaw = [0];

    for (var i = 1; i < n; i++) {
        var h  = records[i].High,   l  = records[i].Low;
        var ph = records[i-1].High, pl = records[i-1].Low, pc = records[i-1].Close;

        var hl = h - l;
        var hc = Math.abs(h - pc);
        var lc = Math.abs(l - pc);
        trRaw.push(Math.max(hl, hc, lc));

        var up = h - ph;
        var dn = pl - l;
        pDMRaw.push((up > dn && up > 0) ? up : 0);
        mDMRaw.push((dn > up && dn > 0) ? dn : 0);
    }

    // Step 2: initial Wilder sum (indices 1..period)
    var smTR = 0, smPDM = 0, smMDM = 0;
    for (var j = 1; j <= period; j++) {
        smTR  += trRaw[j];
        smPDM += pDMRaw[j];
        smMDM += mDMRaw[j];
    }

    // Step 3: compute DI and DX at each index from `period` onwards
    var dxArr = [];
    for (var i = 0; i < n; i++) dxArr.push(NaN);

    function toDX(st, sp, sm) {
        var pdi = st > 0 ? 100 * sp / st : 0;
        var mdi = st > 0 ? 100 * sm / st : 0;
        var dx  = (pdi + mdi) > 0 ? 100 * Math.abs(pdi - mdi) / (pdi + mdi) : 0;
        return { pdi: pdi, mdi: mdi, dx: dx };
    }

    var v = toDX(smTR, smPDM, smMDM);
    plusDIArr[period]  = v.pdi;
    minusDIArr[period] = v.mdi;
    dxArr[period]      = v.dx;

    for (var k = period + 1; k < n; k++) {
        smTR  = smTR  - smTR  / period + trRaw[k];
        smPDM = smPDM - smPDM / period + pDMRaw[k];
        smMDM = smMDM - smMDM / period + mDMRaw[k];
        v = toDX(smTR, smPDM, smMDM);
        plusDIArr[k]  = v.pdi;
        minusDIArr[k] = v.mdi;
        dxArr[k]      = v.dx;
    }

    // Step 4: ADX = Wilder average of DX, starting at index 2×period-1
    // First ADX = simple average of DX[period .. 2*period-1]
    var dxSum = 0;
    for (var j = period; j < period * 2; j++) {
        dxSum += isNaN(dxArr[j]) ? 0 : dxArr[j];
    }
    var adxVal = dxSum / period;
    adxArr[period * 2 - 1] = adxVal;

    for (var k = period * 2; k < n; k++) {
        adxVal = (adxVal * (period - 1) + (isNaN(dxArr[k]) ? 0 : dxArr[k])) / period;
        adxArr[k] = adxVal;
    }

    return { adx: adxArr, plusDI: plusDIArr, minusDI: minusDIArr };
}

// ── SMA of any array ──
// Used to compute average ATR over last N candles for "ATR spike" detection
function calcSMA(arr, period) {
    var result = [];
    for (var i = 0; i < arr.length; i++) {
        if (i < period - 1) { result.push(NaN); continue; }
        var sum = 0, count = 0;
        for (var j = i - period + 1; j <= i; j++) {
            if (!isNaN(arr[j])) { sum += arr[j]; count++; }
        }
        result.push(count > 0 ? sum / count : NaN);
    }
    return result;
}

// =====================================================================
// SIGNAL LOGIC
// =====================================================================

// ── H4 Bias ──
// Returns "BULL" / "BEAR" / "NEUTRAL" based on EMA3/EMA8/EMA200 on H4
// Uses the last CLOSED H4 candle (index n-2 since n-1 is still forming)
function getH4Bias(recordsH4) {
    if (!recordsH4 || recordsH4.length < 203) return "NEUTRAL";

    // Exclude the currently-forming (unclosed) candle
    var recs = recordsH4.slice(0, recordsH4.length - 1);
    var n    = recs.length;

    var ema3Arr   = TA.EMA(recs, 3);
    var ema8Arr   = TA.EMA(recs, 8);
    var ema200Arr = TA.EMA(recs, 200);

    var ema3   = ema3Arr[n-1];
    var ema8   = ema8Arr[n-1];
    var ema200 = ema200Arr[n-1];
    var close  = recs[n-1].Close;

    if (isNaN(ema3) || isNaN(ema8) || isNaN(ema200)) return "NEUTRAL";

    if (ema3 > ema8 && close > ema200) return "BULL";
    if (ema3 < ema8 && close < ema200) return "BEAR";
    return "NEUTRAL";
}

// ── M15 Signal ──
// Checks 5 conditions on M15 candles:
//   1. EMA3/EMA8 fresh crossover (strict: cross happened on last closed candle)
//   2. Price above/below VWAP
//   3. ADX > ADX_MIN
//   4. Current ATR > SMA(ATR, 20) — confirms volatility spike
//   5. H4 bias must match direction (passed as parameter)
//
// Returns { signal: "LONG"|"SHORT"|null, atr, adx, vwap }
function checkM15Signal(recordsM15, h4Bias) {
    var empty = { signal: null, atr: 0, adx: 0, vwap: 0 };
    if (!recordsM15 || recordsM15.length < 60) return empty;

    // Work on closed candles only (exclude last forming candle)
    var recs = recordsM15.slice(0, recordsM15.length - 1);
    var n    = recs.length;
    if (n < 60) return empty;

    // Compute indicators
    var ema3Arr  = TA.EMA(recs, 3);
    var ema8Arr  = TA.EMA(recs, 8);
    var vwapArr  = calcVWAP(recs);
    var atrArr   = calcATR(recs, ATR_PERIOD);
    var adxRes   = calcADX(recs, ADX_PERIOD);
    var atrSMAArr = calcSMA(atrArr, 20);

    // Current (n-1) and previous (n-2) closed candle indices
    var cur = n - 1, prv = n - 2;

    var e3c = ema3Arr[cur], e3p = ema3Arr[prv];
    var e8c = ema8Arr[cur], e8p = ema8Arr[prv];
    var vwap   = vwapArr[cur];
    var atr    = atrArr[cur];
    var atrSMA = atrSMAArr[cur];
    var adx    = adxRes.adx[cur];

    // Validate — skip if any indicator is unavailable
    if (isNaN(e3c) || isNaN(e3p) || isNaN(e8c) || isNaN(e8p)) return empty;
    if (isNaN(vwap) || isNaN(atr) || isNaN(atrSMA) || isNaN(adx)) return empty;

    var close = recs[cur].Close;

    // ── Condition 1: Fresh EMA crossover ──
    // Crossover UP:   previous candle EMA3 was ≤ EMA8, current EMA3 > EMA8
    // Crossover DOWN: previous candle EMA3 was ≥ EMA8, current EMA3 < EMA8
    var crossUp   = (e3p <= e8p) && (e3c > e8c);
    var crossDown = (e3p >= e8p) && (e3c < e8c);

    // ── Condition 2: Price vs VWAP ──
    var aboveVWAP = close > vwap;
    var belowVWAP = close < vwap;

    // ── Condition 3: ADX gate ──
    var adxOk = adx > ADX_MIN;

    // ── Condition 4: ATR spike ──
    var atrSpike = atr > atrSMA;

    // ── Combined signal (all 5 conditions including H4 bias) ──
    var signal = null;
    if (h4Bias === "BULL" && crossUp   && aboveVWAP && adxOk && atrSpike) signal = "LONG";
    if (h4Bias === "BEAR" && crossDown && belowVWAP && adxOk && atrSpike) signal = "SHORT";

    return { signal: signal, atr: atr, adx: adx, vwap: vwap };
}

// =====================================================================
// POSITION HELPERS (live mode)
// =====================================================================

// Check if any position is currently open
function isPositionOpen() {
    try {
        var positions = exchange.GetPosition();
        if (!positions || positions.length === 0) return false;
        for (var i = 0; i < positions.length; i++) {
            if (Math.abs(positions[i].Amount) > 0) return true;
        }
        return false;
    } catch (e) {
        return true; // assume still open on error
    }
}

// Get latest market price
function getCurrentPrice() {
    var ticker = exchange.GetTicker();
    return ticker ? ticker.Last : 0;
}

// Close position with market-like limit order (small slippage to ensure fill)
function closePositionMarket(dir, size) {
    try {
        var price = getCurrentPrice();
        if (dir === "LONG") {
            exchange.SetDirection("closebuy");
            exchange.Sell(price * 0.999, size);  // limit slightly below market = quick fill
        } else {
            exchange.SetDirection("closesell");
            exchange.Buy(price * 1.001, size);
        }
        Log("[CLOSE] Position closed:", dir, "| size:", size);
    } catch (e) {
        Log("[ERROR] Close failed:", e.message || e);
    }
}

// =====================================================================
// RISK MANAGEMENT
// =====================================================================

// Check max drawdown. If exceeded: close position + start 12h cooldown.
// Returns true if bot should skip trading this cycle.
function checkDrawdown(balance) {
    // Update peak balance
    if (balance > peakBalance) peakBalance = balance;

    var dd = peakBalance > 0 ? (peakBalance - balance) / peakBalance : 0;

    if (dd >= MAX_DD_PCT) {
        // Only trigger once per drawdown event (not if already in cooldown)
        if (cooldownUntil <= Date.now()) {
            Log("⛔ ====================================================");
            Log("⛔ [CRITICAL] Max drawdown " + (dd * 100).toFixed(1) + "% reached!");
            Log("⛔ Peak balance: $" + peakBalance.toFixed(2) + " | Current: $" + balance.toFixed(2));
            Log("⛔ Closing any open position and halting for " + COOLDOWN_HOURS + "h...");
            Log("⛔ ====================================================");

            // Close open position if exists
            if (currentTrade) {
                closePositionMarket(currentTrade.direction, currentTrade.size);
                currentTrade = null;
            }

            // Set cooldown expiry
            cooldownUntil = Date.now() + COOLDOWN_HOURS * 3600000;
            Log("⛔ Cooldown until: " + new Date(cooldownUntil).toUTCString());
        }
        return true; // should pause trading
    }
    return false;
}

// =====================================================================
// TRADE EXECUTION (live mode)
// =====================================================================

// Open a new trade using a limit order at current market price (Maker fee)
// dir = "LONG" or "SHORT"
// atr = current ATR value (used for SL/TP distance and position sizing)
function executeLiveTrade(dir, atr) {
    var ticker = exchange.GetTicker();
    if (!ticker) { Log("[ERROR] No ticker data."); return false; }
    var entryPrice = ticker.Last;

    var account = exchange.GetAccount();
    if (!account) { Log("[ERROR] Cannot fetch account balance."); return false; }
    liveBalance = (account.Balance || 0) + (account.FrozenBalance || 0);
    if (liveBalance <= 0) { Log("[WARN] Zero balance — skipping trade."); return false; }

    // Position sizing: risk exactly RISK_PER_TRADE of balance
    var slDist   = ATR_SL_MULT * atr;
    var tpDist   = ATR_TP_MULT * atr;
    var riskUsdt = liveBalance * RISK_PER_TRADE;
    var size     = floorTo(riskUsdt / slDist, 3);

    if (size <= 0) { Log("[ERROR] Calculated size is zero. ATR:", atr); return false; }

    var tpPrice = dir === "LONG" ? entryPrice + tpDist : entryPrice - tpDist;
    var slPrice = dir === "LONG" ? entryPrice - slDist : entryPrice + slDist;

    Log("\n[TRADE] Opening", dir, "on", LIVE_SYMBOL);
    Log("[TRADE] Entry: $" + entryPrice.toFixed(2) +
        " | TP: $" + tpPrice.toFixed(2) + " (+" + (ATR_TP_MULT * 100 * atr / entryPrice).toFixed(2) + "%)" +
        " | SL: $" + slPrice.toFixed(2) + " (-" + (ATR_SL_MULT * 100 * atr / entryPrice).toFixed(2) + "%)" +
        " | Size: " + size + " | Risk: $" + riskUsdt.toFixed(2));

    // Place limit order (acts as Maker order)
    try {
        if (dir === "LONG") {
            exchange.SetDirection("buy");
            exchange.Buy(entryPrice, size);
        } else {
            exchange.SetDirection("sell");
            exchange.Sell(entryPrice, size);
        }
    } catch (e) {
        Log("[ERROR] Order failed:", e.message || e);
        return false;
    }

    currentTrade = {
        direction:  dir,
        size:       size,
        entryPrice: entryPrice,
        tpPrice:    tpPrice,
        slPrice:    slPrice,
        entryTime:  Date.now()
    };
    return true;
}

// =====================================================================
// TRADE MONITORING (live mode)
// =====================================================================

// Poll price until TP or SL is hit, then close and update stats
function monitorLiveTrade() {
    if (!currentTrade) return;

    var dir   = currentTrade.direction;
    var tp    = currentTrade.tpPrice;
    var sl    = currentTrade.slPrice;
    var entry = currentTrade.entryPrice;
    var size  = currentTrade.size;

    Log("[MONITOR]", dir, "| Entry: $" + entry.toFixed(2) +
        " | TP: $" + tp.toFixed(2) + " | SL: $" + sl.toFixed(2));

    var closeReason = "UNKNOWN";
    var closePrice  = entry;

    while (true) {
        var price = getCurrentPrice();
        if (price <= 0) { Sleep(POLL_MS); continue; }

        if (dir === "LONG") {
            if (price >= tp) {
                Log("[TP] Long TP hit at $" + price.toFixed(2));
                closePositionMarket(dir, size);
                closePrice = tp; closeReason = "TP";
                break;
            }
            if (price <= sl) {
                Log("[SL] Long SL hit at $" + price.toFixed(2));
                closePositionMarket(dir, size);
                closePrice = sl; closeReason = "SL";
                break;
            }
        } else {
            if (price <= tp) {
                Log("[TP] Short TP hit at $" + price.toFixed(2));
                closePositionMarket(dir, size);
                closePrice = tp; closeReason = "TP";
                break;
            }
            if (price >= sl) {
                Log("[SL] Short SL hit at $" + price.toFixed(2));
                closePositionMarket(dir, size);
                closePrice = sl; closeReason = "SL";
                break;
            }
        }

        // Show live PnL while waiting
        var pnl = dir === "LONG" ? (price - entry) * size : (entry - price) * size;
        Log("[MONITOR] $" + price.toFixed(2) +
            " | PnL: " + signStr(pnl) + "$" + pnl.toFixed(2));

        Sleep(POLL_MS);
    }

    // Calculate and log PnL
    var pnlUsdt = dir === "LONG"
        ? (closePrice - entry) * size
        : (entry - closePrice) * size;
    var pnlPct = pnlUsdt / (entry * size) * 100;

    liveStats.totalTrades++;
    liveStats.totalPnl += pnlUsdt;
    if (closeReason === "TP") liveStats.wins++;
    else                      liveStats.losses++;

    // Fetch updated balance
    var acc = exchange.GetAccount();
    if (acc) liveBalance = (acc.Balance || 0) + (acc.FrozenBalance || 0);
    else     liveBalance += pnlUsdt;

    Log("======================================");
    Log("[RESULT] Reason  :", closeReason);
    Log("[RESULT] PnL     :", signStr(pnlUsdt) + "$" + pnlUsdt.toFixed(2),
        "(" + signStr(pnlPct) + pnlPct.toFixed(2) + "%)");
    Log("[RESULT] Balance : $" + liveBalance.toFixed(2));
    Log("======================================\n");

    LogProfit(liveBalance);
    currentTrade = null;
}

