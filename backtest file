// =====================================================================
// CONFIGURATION — match these values in FMZ backtest settings too
// =====================================================================

var INITIAL_CAPITAL = 10000;   // starting balance in USDT
var LEVERAGE        = 10;      // leverage (set same in FMZ backtest config)
var RISK_PER_TRADE  = 0.02;    // 2% of balance risked per trade

var ATR_PERIOD      = 14;      // ATR period
var ATR_SL_MULT     = 1.5;     // stop loss  = 1.5 × ATR from entry
var ATR_TP_MULT     = 3.0;     // take profit = 3.0 × ATR from entry  (R:R 2:1)

var ADX_PERIOD      = 14;      // ADX calculation period
var ADX_MIN         = 20;      // minimum ADX value to allow entry

var MAX_DD_PCT      = 0.20;    // max drawdown threshold (20%)
var COOLDOWN_HOURS  = 12;      // hours to pause after max DD hit

var POLL_MS         = 60000;   // monitoring poll interval in ms (1 min sim time)
                               // checks price 15× per M15 candle — accurate enough

// =====================================================================
// GLOBAL STATE
// =====================================================================

var currentTrade  = null;          // active trade object, null when flat
var peakBalance   = INITIAL_CAPITAL;
var cooldownUntil = 0;             // Unix ms: when cooldown expires

var stats = {
    balance:     INITIAL_CAPITAL,
    totalTrades: 0,
    wins:        0,
    losses:      0,
    totalPnl:    0.0,
    grossProfit: 0.0,
    grossLoss:   0.0
};

// =====================================================================
// UTILITY HELPERS
// =====================================================================

// Floor value to N decimal places (avoids over-precision in order sizes)
function floorTo(val, decimals) {
    var f = Math.pow(10, decimals);
    return Math.floor(val * f) / f;
}

// Format number with leading sign for display
function signStr(val) {
    return val >= 0 ? "+" : "";
}

// =====================================================================
// INDICATOR CALCULATIONS
// All computed manually — no external libraries required
// =====================================================================

// ── VWAP ──────────────────────────────────────────────────────────────
// Cumulative (ΣTP×Volume / ΣVolume), resets every UTC calendar day.
// TP = (High + Low + Close) / 3
function calcVWAP(records) {
    var result   = [];
    var cumTPV   = 0;
    var cumVol   = 0;
    var dayStart = -1;

    for (var i = 0; i < records.length; i++) {
        var r   = records[i];
        var tp  = (r.High + r.Low + r.Close) / 3;
        var day = Math.floor(r.Time / 86400000);   // UTC day number

        if (day !== dayStart) {                    // new day → reset
            cumTPV   = 0;
            cumVol   = 0;
            dayStart = day;
        }

        cumTPV += tp * r.Volume;
        cumVol += r.Volume;
        result.push(cumVol > 0 ? cumTPV / cumVol : tp);
    }
    return result;
}

// ── ATR (Average True Range) ──────────────────────────────────────────
// TR  = max(High-Low, |High-prevClose|, |Low-prevClose|)
// ATR = Wilder smoothing: (ATR[i-1] × (period-1) + TR[i]) / period
// First value = simple average of first `period` TR values.
function calcATR(records, period) {
    var n      = records.length;
    var result = [];
    var trArr  = [];

    for (var i = 0; i < n; i++) {
        result.push(NaN);
        if (i === 0) {
            trArr.push(records[0].High - records[0].Low);
        } else {
            var hl = records[i].High - records[i].Low;
            var hc = Math.abs(records[i].High - records[i-1].Close);
            var lc = Math.abs(records[i].Low  - records[i-1].Close);
            trArr.push(Math.max(hl, hc, lc));
        }
    }

    if (n < period) return result;

    // Seed: simple average of first `period` TR values
    var sum = 0;
    for (var j = 0; j < period; j++) sum += trArr[j];
    result[period - 1] = sum / period;

    // Wilder smoothing for remaining values
    for (var k = period; k < n; k++) {
        result[k] = (result[k-1] * (period - 1) + trArr[k]) / period;
    }
    return result;
}

// ── ADX (Average Directional Index) ──────────────────────────────────
// Classic Wilder method:
//   +DM / -DM / TR → Wilder smoothed → +DI / -DI → DX → ADX
// Returns object { adx[], plusDI[], minusDI[] }
function calcADX(records, period) {
    var n = records.length;

    // Pre-fill output arrays with NaN
    var adxArr     = [];
    var plusDIArr  = [];
    var minusDIArr = [];
    for (var i = 0; i < n; i++) {
        adxArr.push(NaN);
        plusDIArr.push(NaN);
        minusDIArr.push(NaN);
    }

    // Need at least 2×period candles for first valid ADX
    if (n < period * 2 + 1) {
        return { adx: adxArr, plusDI: plusDIArr, minusDI: minusDIArr };
    }

    // Step 1 — raw TR, +DM, -DM per candle (index 0 = placeholder)
    var trRaw  = [0];
    var pDMRaw = [0];
    var mDMRaw = [0];

    for (var i = 1; i < n; i++) {
        var h  = records[i].High;
        var l  = records[i].Low;
        var pc = records[i-1].Close;
        var ph = records[i-1].High;
        var pl = records[i-1].Low;

        trRaw.push(Math.max(h - l, Math.abs(h - pc), Math.abs(l - pc)));

        var up = h - ph;
        var dn = pl - l;
        pDMRaw.push((up > dn && up > 0) ? up : 0);
        mDMRaw.push((dn > up && dn > 0) ? dn : 0);
    }

    // Step 2 — initial Wilder sum over indices 1..period
    var smTR  = 0;
    var smPDM = 0;
    var smMDM = 0;
    for (var j = 1; j <= period; j++) {
        smTR  += trRaw[j];
        smPDM += pDMRaw[j];
        smMDM += mDMRaw[j];
    }

    // Helper: compute +DI, -DI, DX from smoothed values
    function toDX(st, sp, sm) {
        var pdi = st > 0 ? 100 * sp / st : 0;
        var mdi = st > 0 ? 100 * sm / st : 0;
        var dx  = (pdi + mdi) > 0 ? 100 * Math.abs(pdi - mdi) / (pdi + mdi) : 0;
        return { pdi: pdi, mdi: mdi, dx: dx };
    }

    // Step 3 — +DI, -DI, DX from index `period` onwards
    var dxArr = [];
    for (var i = 0; i < n; i++) dxArr.push(NaN);

    var v = toDX(smTR, smPDM, smMDM);
    plusDIArr[period]  = v.pdi;
    minusDIArr[period] = v.mdi;
    dxArr[period]      = v.dx;

    for (var k = period + 1; k < n; k++) {
        smTR  = smTR  - smTR  / period + trRaw[k];
        smPDM = smPDM - smPDM / period + pDMRaw[k];
        smMDM = smMDM - smMDM / period + mDMRaw[k];
        v = toDX(smTR, smPDM, smMDM);
        plusDIArr[k]  = v.pdi;
        minusDIArr[k] = v.mdi;
        dxArr[k]      = v.dx;
    }

    // Step 4 — ADX = Wilder average of DX
    // Seed: simple average of DX[period .. 2*period-1]
    var dxSum = 0;
    for (var j = period; j < period * 2; j++) {
        dxSum += isNaN(dxArr[j]) ? 0 : dxArr[j];
    }
    var adxVal = dxSum / period;
    adxArr[period * 2 - 1] = adxVal;

    for (var k = period * 2; k < n; k++) {
        adxVal = (adxVal * (period - 1) + (isNaN(dxArr[k]) ? 0 : dxArr[k])) / period;
        adxArr[k] = adxVal;
    }

    return { adx: adxArr, plusDI: plusDIArr, minusDI: minusDIArr };
}

// ── Simple Moving Average of any numeric array ────────────────────────
// Used to compute ATR average for the "ATR spike" condition.
function calcSMA(arr, period) {
    var result = [];
    for (var i = 0; i < arr.length; i++) {
        if (i < period - 1) { result.push(NaN); continue; }
        var sum = 0, count = 0;
        for (var j = i - period + 1; j <= i; j++) {
            if (!isNaN(arr[j])) { sum += arr[j]; count++; }
        }
        result.push(count > 0 ? sum / count : NaN);
    }
    return result;
}

// =====================================================================
// SIGNAL LOGIC
// =====================================================================

// ── H4 Trend Bias ─────────────────────────────────────────────────────
// Returns "BULL", "BEAR", or "NEUTRAL"
// Uses the last CLOSED H4 candle (always excludes the forming one)
function getH4Bias(recordsH4) {
    if (!recordsH4 || recordsH4.length < 203) return "NEUTRAL";

    // Slice off the still-forming H4 candle
    var recs = recordsH4.slice(0, recordsH4.length - 1);
    var n    = recs.length;

    var ema3Arr   = TA.EMA(recs, 3);
    var ema8Arr   = TA.EMA(recs, 8);
    var ema200Arr = TA.EMA(recs, 200);

    var ema3   = ema3Arr[n - 1];
    var ema8   = ema8Arr[n - 1];
    var ema200 = ema200Arr[n - 1];
    var close  = recs[n - 1].Close;

    if (isNaN(ema3) || isNaN(ema8) || isNaN(ema200)) return "NEUTRAL";

    if (ema3 > ema8 && close > ema200) return "BULL";
    if (ema3 < ema8 && close < ema200) return "BEAR";
    return "NEUTRAL";
}

// ── M15 Entry Signal ──────────────────────────────────────────────────
// Checks all 5 conditions on the last two closed M15 candles.
// Condition 1 : Fresh EMA3/EMA8 crossover (strict: happened on current candle)
// Condition 2 : Price on correct side of VWAP
// Condition 3 : ADX > ADX_MIN
// Condition 4 : Current ATR > 20-period ATR average (volatility expansion)
// Condition 5 : H4 bias matches direction (passed as parameter)
//
// Returns { signal: "LONG"|"SHORT"|null, atr, adx, vwap, ema3, ema8 }
function checkM15Signal(recordsM15, h4Bias) {
    var empty = { signal: null, atr: 0, adx: 0, vwap: 0, ema3: 0, ema8: 0 };
    if (!recordsM15 || recordsM15.length < 60) return empty;

    // Work only on closed candles (remove forming candle)
    var recs = recordsM15.slice(0, recordsM15.length - 1);
    var n    = recs.length;
    if (n < 60) return empty;

    // Compute indicators
    var ema3Arr   = TA.EMA(recs, 3);
    var ema8Arr   = TA.EMA(recs, 8);
    var vwapArr   = calcVWAP(recs);
    var atrArr    = calcATR(recs, ATR_PERIOD);
    var adxResult = calcADX(recs, ADX_PERIOD);
    var atrSMAArr = calcSMA(atrArr, 20);

    // Current and previous closed candle indices
    var cur = n - 1;
    var prv = n - 2;

    var e3c    = ema3Arr[cur];
    var e3p    = ema3Arr[prv];
    var e8c    = ema8Arr[cur];
    var e8p    = ema8Arr[prv];
    var vwap   = vwapArr[cur];
    var atr    = atrArr[cur];
    var atrSMA = atrSMAArr[cur];
    var adx    = adxResult.adx[cur];

    // Reject if any indicator is still warming up
    if (isNaN(e3c) || isNaN(e3p) || isNaN(e8c) || isNaN(e8p)) return empty;
    if (isNaN(vwap) || isNaN(atr) || isNaN(atrSMA) || isNaN(adx)) return empty;
    if (atr <= 0) return empty;

    var close = recs[cur].Close;

    // ── Condition 1: Fresh EMA3/EMA8 crossover ──
    // Cross UP:   previous candle EMA3 ≤ EMA8, current EMA3 > EMA8
    // Cross DOWN: previous candle EMA3 ≥ EMA8, current EMA3 < EMA8
    var crossUp   = (e3p <= e8p) && (e3c > e8c);
    var crossDown = (e3p >= e8p) && (e3c < e8c);

    // ── Condition 2: Price vs VWAP ──
    var aboveVWAP = close > vwap;
    var belowVWAP = close < vwap;

    // ── Condition 3: ADX gate ──
    var adxOk = adx > ADX_MIN;

    // ── Condition 4: ATR volatility expansion ──
    var atrSpike = atr > atrSMA;

    // ── Signal: all conditions + H4 bias agreement ──
    var signal = null;
    if (h4Bias === "BULL" && crossUp   && aboveVWAP && adxOk && atrSpike) signal = "LONG";
    if (h4Bias === "BEAR" && crossDown && belowVWAP && adxOk && atrSpike) signal = "SHORT";

    return { signal: signal, atr: atr, adx: adx, vwap: vwap, ema3: e3c, ema8: e8c };
}

// =====================================================================
// POSITION HELPERS
// =====================================================================

// Get current market price via ticker
function getCurrentPrice() {
    var ticker = exchange.GetTicker();
    return ticker ? ticker.Last : 0;
}

// Close position with a market order
// FMZ market order: price = -1
// Using SetDirection ensures FMZ applies the correct close semantics
function closePositionMarket(dir, size) {
    try {
        if (dir === "LONG") {
            exchange.SetDirection("closebuy");
            exchange.Sell(-1, size);
        } else {
            exchange.SetDirection("closesell");
            exchange.Buy(-1, size);
        }
        Log("[CLOSE] Market close →", dir, "| size:", size);
    } catch (e) {
        Log("[ERROR] Close failed:", e.message || e);
    }
}

// =====================================================================
// DRAWDOWN GUARD
// =====================================================================

// Called every loop iteration.
// Returns true if trading should be paused (in cooldown or just triggered).
function checkDrawdown(balance) {
    // Update running peak
    if (balance > peakBalance) peakBalance = balance;

    var dd = peakBalance > 0 ? (peakBalance - balance) / peakBalance : 0;

    if (dd >= MAX_DD_PCT) {
        // Trigger cooldown if not already active
        if (cooldownUntil <= Date.now()) {
            Log("⛔ ==================================================");
            Log("⛔ [DRAWDOWN] " + (dd * 100).toFixed(1) + "% drawdown reached!");
            Log("⛔ Peak: $" + peakBalance.toFixed(2) + " | Current: $" + balance.toFixed(2));

            // Close any open trade immediately
            if (currentTrade) {
                closePositionMarket(currentTrade.direction, currentTrade.size);
                currentTrade = null;
            }

            cooldownUntil = Date.now() + COOLDOWN_HOURS * 3600000;
            Log("⛔ Trading halted for " + COOLDOWN_HOURS + "h — resumes at: " +
                new Date(cooldownUntil).toUTCString());
            Log("⛔ ==================================================");
        }
        return true; // pause trading
    }
    return false;
}

// =====================================================================
// TRADE EXECUTION
// =====================================================================

// Open a new position with a market order.
// Size is calculated so that a full SL hit = exactly RISK_PER_TRADE of balance.
function executeTrade(dir, atr) {
    // Get current price
    var ticker = exchange.GetTicker();
    if (!ticker || ticker.Last <= 0) {
        Log("[ERROR] No ticker — cannot enter trade.");
        return false;
    }
    var entryPrice = ticker.Last;

    // Get current balance
    var account = exchange.GetAccount();
    if (!account) {
        Log("[ERROR] Cannot fetch account.");
        return false;
    }
    var balance = (account.Balance || 0) + (account.FrozenBalance || 0);
    if (balance <= 0) {
        Log("[WARN] Zero balance — skipping.");
        return false;
    }

    // ── Position sizing ──────────────────────────────────────────
    // slDist  = price distance from entry to stop loss
    // riskUsd = max USD loss per trade (2% of balance)
    // size    = riskUsd / slDist  (in base currency units)
    var slDist   = ATR_SL_MULT * atr;
    var tpDist   = ATR_TP_MULT * atr;
    var riskUsd  = balance * RISK_PER_TRADE;
    var size     = floorTo(riskUsd / slDist, 3);

    if (size <= 0) {
        Log("[ERROR] Size is zero. ATR:", atr.toFixed(4), "| slDist:", slDist.toFixed(4));
        return false;
    }

    // ── TP and SL price levels ────────────────────────────────────
    var tpPrice, slPrice;
    if (dir === "LONG") {
        tpPrice = entryPrice + tpDist;
        slPrice = entryPrice - slDist;
    } else {
        tpPrice = entryPrice - tpDist;
        slPrice = entryPrice + slDist;
    }

    Log("\n[ENTRY] Opening", dir,
        "| Price: $" + entryPrice.toFixed(4),
        "| Size:", size,
        "| Risk: $" + riskUsd.toFixed(2));
    Log("[ENTRY] TP: $" + tpPrice.toFixed(4) +
        " (+" + (tpDist / entryPrice * 100).toFixed(2) + "%)" +
        " | SL: $" + slPrice.toFixed(4) +
        " (-" + (slDist / entryPrice * 100).toFixed(2) + "%)");

    // ── Place market order (price = -1 in FMZ = market) ──────────
    try {
        if (dir === "LONG") {
            exchange.SetDirection("buy");
            exchange.Buy(-1, size);
        } else {
            exchange.SetDirection("sell");
            exchange.Sell(-1, size);
        }
    } catch (e) {
        Log("[ERROR] Order failed:", e.message || e);
        return false;
    }

    // Record trade state
    currentTrade = {
        direction:  dir,
        size:       size,
        entryPrice: entryPrice,
        tpPrice:    tpPrice,
        slPrice:    slPrice,
        entryTime:  Date.now()
    };
    return true;
}

// =====================================================================
// TRADE MONITORING LOOP
// =====================================================================

// Polls price every POLL_MS milliseconds of simulated time.
// Exits on TP hit, SL hit.
// In FMZ backtest, Sleep(POLL_MS) advances the simulation clock.
function monitorTrade() {
    if (!currentTrade) return;

    var dir   = currentTrade.direction;
    var tp    = currentTrade.tpPrice;
    var sl    = currentTrade.slPrice;
    var entry = currentTrade.entryPrice;
    var size  = currentTrade.size;

    Log("[MONITOR] Watching", dir,
        "| TP: $" + tp.toFixed(4),
        "| SL: $" + sl.toFixed(4));

    var closeReason = "OPEN";
    var closePrice  = entry;

    while (true) {
        // ── Drawdown check while in trade ──────────────────────
        var acc = exchange.GetAccount();
        if (acc) {
            var bal = (acc.Balance || 0) + (acc.FrozenBalance || 0);
            if (checkDrawdown(bal)) {
                // checkDrawdown already closed the position
                closeReason = "DD_STOP";
                closePrice  = getCurrentPrice();
                break;
            }
        }

        var price = getCurrentPrice();
        if (price <= 0) { Sleep(POLL_MS); continue; }

        // ── TP / SL check ──────────────────────────────────────
        if (dir === "LONG") {
            if (price >= tp) {
                closePositionMarket(dir, size);
                closePrice = tp; closeReason = "TP";
                break;
            }
            if (price <= sl) {
                closePositionMarket(dir, size);
                closePrice = sl; closeReason = "SL";
                break;
            }
        } else {
            if (price <= tp) {
                closePositionMarket(dir, size);
                closePrice = tp; closeReason = "TP";
                break;
            }
            if (price >= sl) {
                closePositionMarket(dir, size);
                closePrice = sl; closeReason = "SL";
                break;
            }
        }

        // ── Live PnL log ───────────────────────────────────────
        var unrealised = dir === "LONG"
            ? (price - entry) * size
            : (entry - price) * size;
        Log("[MONITOR] $" + price.toFixed(4) +
            " | PnL: " + signStr(unrealised) + "$" + unrealised.toFixed(2));

        Sleep(POLL_MS);
    }

    // ── Settle trade ───────────────────────────────────────────
    var pnlUsdt = dir === "LONG"
        ? (closePrice - entry) * size
        : (entry - closePrice) * size;

    stats.totalTrades++;
    stats.totalPnl += pnlUsdt;
    if (closeReason === "TP" || (closeReason !== "SL" && pnlUsdt > 0)) {
        stats.wins++;
        stats.grossProfit += pnlUsdt;
    } else {
        stats.losses++;
        stats.grossLoss += Math.abs(pnlUsdt);
    }

    // Fetch actual balance from FMZ (most accurate source in backtest)
    var accFinal = exchange.GetAccount();
    if (accFinal) {
        stats.balance = (accFinal.Balance || 0) + (accFinal.FrozenBalance || 0);
    } else {
        stats.balance += pnlUsdt;
    }

    var pnlPct = entry > 0 ? pnlUsdt / (entry * size) * 100 : 0;
    var sign   = signStr(pnlUsdt);

    Log("═══════════════════════════════════════");
    Log("[RESULT] Reason  : " + closeReason);
    Log("[RESULT] PnL     : " + sign + "$" + pnlUsdt.toFixed(4) +
        "  (" + sign + pnlPct.toFixed(2) + "%)");
    Log("[RESULT] Balance : $" + stats.balance.toFixed(2));
    Log("═══════════════════════════════════════\n");

    // Plot balance on FMZ profit chart
    LogProfit(stats.balance);

    currentTrade = null;
}

// =====================================================================
// DASHBOARD — printed each scan cycle
// =====================================================================

function printDashboard(h4Bias, m15Result, price) {
    var signal = m15Result.signal;
    var adx    = m15Result.adx;
    var atr    = m15Result.atr;
    var vwap   = m15Result.vwap;
    var ema3   = m15Result.ema3;
    var ema8   = m15Result.ema8;

    var dd = peakBalance > 0
        ? (peakBalance - stats.balance) / peakBalance * 100
        : 0;

    var h4Str = h4Bias === "BULL"
        ? "Bullish (EMA3 > EMA8 & price > EMA200)"
        : h4Bias === "BEAR"
        ? "Bearish (EMA3 < EMA8 & price < EMA200)"
        : "Neutral";

    var m15Str = signal === "LONG"  ? "EMA3 Cross UP   → LONG setup"  :
                 signal === "SHORT" ? "EMA3 Cross DOWN → SHORT setup" :
                 "No Signal";

    var cdStr = cooldownUntil > Date.now()
        ? "ON — " + ((cooldownUntil - Date.now()) / 3600000).toFixed(1) + "h left"
        : "OFF";

    var wPct = stats.totalTrades > 0
        ? (stats.wins / stats.totalTrades * 100).toFixed(1)
        : "0.0";
    var pf = stats.grossLoss > 0
        ? (stats.grossProfit / stats.grossLoss).toFixed(2)
        : (stats.grossProfit > 0 ? "∞" : "0.00");

    Log("╔══════════════════════════════════════════╗");
    Log("║   THE SURGEON BOT v2 — BACKTEST          ║");
    Log("╠══════════════════════════════════════════╣");
    Log("║  Price     : $" + price.toFixed(4));
    Log("║  H4 Bias   : " + h4Str);
    Log("║  M15 Signal: " + m15Str);
    Log("║  EMA3/EMA8 : " + (isNaN(ema3) ? "---" : ema3.toFixed(4)) +
        " / " + (isNaN(ema8) ? "---" : ema8.toFixed(4)));
    Log("║  ADX (14)  : " + (isNaN(adx)  ? "---" : adx.toFixed(1)));
    Log("║  ATR (14)  : $" + (isNaN(atr) ? "---" : atr.toFixed(4)));
    Log("║  VWAP      : $" + (isNaN(vwap)? "---" : vwap.toFixed(4)));
    Log("╠══════════════════════════════════════════╣");

    if (currentTrade) {
        var unrealised = currentTrade.direction === "LONG"
            ? (price - currentTrade.entryPrice) * currentTrade.size
            : (currentTrade.entryPrice - price) * currentTrade.size;
        var tpPct = (Math.abs(currentTrade.tpPrice - currentTrade.entryPrice) /
                    currentTrade.entryPrice * 100).toFixed(2);
        var slPct = (Math.abs(currentTrade.slPrice - currentTrade.entryPrice) /
                    currentTrade.entryPrice * 100).toFixed(2);
        Log("║  ── Open Trade ──────────────────────────");
        Log("║  Direction : " + currentTrade.direction);
        Log("║  Entry     : $" + currentTrade.entryPrice.toFixed(4));
        Log("║  TP        : $" + currentTrade.tpPrice.toFixed(4) +
            "  (+" + tpPct + "%)");
        Log("║  SL        : $" + currentTrade.slPrice.toFixed(4) +
            "  (-" + slPct + "%)");
        Log("║  Unreal PnL: " + signStr(unrealised) + "$" + unrealised.toFixed(2));
    } else {
        Log("║  Position  : Flat (no open trade)");
    }

    Log("╠══════════════════════════════════════════╣");
    Log("║  Balance   : $" + stats.balance.toFixed(2));
    Log("║  Peak Bal  : $" + peakBalance.toFixed(2));
    Log("║  Drawdown  : " + dd.toFixed(2) + "%  (max allowed: " +
        (MAX_DD_PCT * 100) + "%)");
    Log("║  Cooldown  : " + cdStr);
    Log("╠══════════════════════════════════════════╣");
    Log("║  Trades    : " + stats.totalTrades +
        "  (W:" + stats.wins + " / L:" + stats.losses + ")");
    Log("║  Win Rate  : " + wPct + "%");
    Log("║  Prof.Fac. : " + pf);
    Log("║  Total PnL : " + signStr(stats.totalPnl) +
        "$" + stats.totalPnl.toFixed(2));
    Log("╚══════════════════════════════════════════╝\n");
}

// =====================================================================
// MAIN — FMZ calls this once; it runs in an infinite loop internally
// =====================================================================

function main() {
    Log("╔══════════════════════════════════════════╗");
    Log("║   THE SURGEON BOT v2 — FMZ BACKTEST     ║");
    Log("╠══════════════════════════════════════════╣");
    Log("║  Strategy  : EMA3/8 Dual-TF + ADX + ATR  ║");
    Log("║  SL / TP   : " + ATR_SL_MULT + "× ATR / " +
        ATR_TP_MULT + "× ATR  (R:R 2:1)      ║");
    Log("║  Risk/Trade: " + (RISK_PER_TRADE * 100) + "%                          ║");
    Log("║  Max DD    : " + (MAX_DD_PCT * 100) + "% → " +
        COOLDOWN_HOURS + "h cooldown           ║");
    Log("╚══════════════════════════════════════════╝\n");

    // Set contract type — works fine in FMZ backtest
    exchange.SetContractType("swap");

    // Read starting balance from FMZ backtest engine
    var account = exchange.GetAccount();
    if (account) {
        var bal = (account.Balance || 0) + (account.FrozenBalance || 0);
        if (bal > 0) {
            stats.balance = bal;
            INITIAL_CAPITAL = bal;
        }
    }
    peakBalance = stats.balance;
    Log("[START] Balance: $" + stats.balance.toFixed(2));

    // ─── Main loop ────────────────────────────────────────────────
    while (true) {

        // ── Cooldown check ─────────────────────────────────────
        if (cooldownUntil > 0 && Date.now() < cooldownUntil) {
            var remH = ((cooldownUntil - Date.now()) / 3600000).toFixed(1);
            Log("⏳ [COOLDOWN] " + remH + "h remaining — bot paused.");
            Sleep(POLL_MS);
            continue;
        }

        // Cooldown just expired
        if (cooldownUntil > 0 && Date.now() >= cooldownUntil) {
            Log("✅ Cooldown ended — bot resumed trading.");
            cooldownUntil = 0;
            peakBalance   = stats.balance; // reset drawdown baseline
        }

        // ── Fetch latest balance and check drawdown ─────────────
        var acc = exchange.GetAccount();
        if (acc) {
            stats.balance = (acc.Balance || 0) + (acc.FrozenBalance || 0);
        }

        if (checkDrawdown(stats.balance)) {
            Sleep(POLL_MS);
            continue;
        }

        // ── Fetch candle data for both timeframes ───────────────
        var recordsH4  = exchange.GetRecords(PERIOD_H4);
        var recordsM15 = exchange.GetRecords(PERIOD_M15);

        if (!recordsH4  || recordsH4.length  < 203 ||
            !recordsM15 || recordsM15.length < 60) {
            Log("[WARN] Insufficient candle data — waiting for warmup...");
            Sleep(POLL_MS);
            continue;
        }

        // ── Compute signals ─────────────────────────────────────
        var h4Bias    = getH4Bias(recordsH4);
        var m15Result = checkM15Signal(recordsM15, h4Bias);
        var price     = getCurrentPrice();

        // ── Print dashboard ─────────────────────────────────────
        printDashboard(h4Bias, m15Result, price);

        // ── Trade logic ─────────────────────────────────────────
        if (!currentTrade) {
            if (m15Result.signal) {
                Log("[SIGNAL] " + m15Result.signal +
                    " | H4:" + h4Bias +
                    " | ADX:" + m15Result.adx.toFixed(1) +
                    " | ATR:$" + m15Result.atr.toFixed(2));

                var ok = executeTrade(m15Result.signal, m15Result.atr);
                if (ok) {
                    monitorTrade();    // blocks until TP or SL hit
                } else {
                    Log("[WARN] Trade execution failed — retrying next cycle.");
                    Sleep(POLL_MS);
                }
            } else {
                Log("[SCAN] No signal | H4:" + h4Bias +
                    " | ADX:" + m15Result.adx.toFixed(1) +
                    " | Flat.");
                Sleep(POLL_MS);
            }
        } else {
            // Unexpected state — resume monitoring
            Log("[RESUME] Resuming trade monitor...");
            monitorTrade();
        }
    }
}
