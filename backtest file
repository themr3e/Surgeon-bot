// Print a detailed status block to the FMZ log every polling cycle
function printDashboard(h4Bias, m15Signal, adxVal, atrVal, vwapVal, price) {
    var now = new Date();
    var utc = now.getUTCFullYear() + "-"
        + ("0" + (now.getUTCMonth()+1)).slice(-2) + "-"
        + ("0" + now.getUTCDate()).slice(-2) + " "
        + ("0" + now.getUTCHours()).slice(-2) + ":"
        + ("0" + now.getUTCMinutes()).slice(-2) + " UTC";

    var dd     = peakBalance > 0 ? (peakBalance - liveBalance) / peakBalance * 100 : 0;
    var ddStr  = dd.toFixed(2) + "%";

    var h4Str = h4Bias === "BULL"
        ? "Bullish (EMA3 > EMA8, Price > EMA200)"
        : h4Bias === "BEAR"
        ? "Bearish (EMA3 < EMA8, Price < EMA200)"
        : "Neutral";

    var m15Str = m15Signal === "LONG"  ? "EMA Cross UP  — LONG setup"  :
                 m15Signal === "SHORT" ? "EMA Cross DOWN — SHORT setup" :
                 "No Signal";

    var cdStr = "OFF";
    if (cooldownUntil > Date.now()) {
        cdStr = "ON — " + ((cooldownUntil - Date.now()) / 3600000).toFixed(1) + "h remaining";
    }

    Log("╔══════════════════════════════════════════╗");
    Log("║    THE SURGEON BOT v2 — LIVE             ║");
    Log("╠══════════════════════════════════════════╣");
    Log("║  Time      : " + utc);
    Log("║  Price     : $" + price.toFixed(2));
    Log("║  H4 Bias   : " + h4Str);
    Log("║  M15 Signal: " + m15Str);
    Log("║  ADX (14)  : " + (isNaN(adxVal)  ? "---" : adxVal.toFixed(1)));
    Log("║  ATR (14)  : $" + (isNaN(atrVal) ? "---" : atrVal.toFixed(2)));
    Log("║  VWAP      : $" + (isNaN(vwapVal)? "---" : vwapVal.toFixed(2)));
    Log("╠══════════════════════════════════════════╣");

    if (currentTrade) {
        var pnl = currentTrade.direction === "LONG"
            ? (price - currentTrade.entryPrice) * currentTrade.size
            : (currentTrade.entryPrice - price) * currentTrade.size;
        var tpDistPct = (Math.abs(currentTrade.tpPrice - currentTrade.entryPrice) / currentTrade.entryPrice * 100).toFixed(2);
        var slDistPct = (Math.abs(currentTrade.slPrice - currentTrade.entryPrice) / currentTrade.entryPrice * 100).toFixed(2);
        Log("║  ── Open Trade ──────────────────────────");
        Log("║  Type    : " + currentTrade.direction);
        Log("║  Entry   : $" + currentTrade.entryPrice.toFixed(2));
        Log("║  TP      : $" + currentTrade.tpPrice.toFixed(2) + "  (+" + tpDistPct + "%)");
        Log("║  SL      : $" + currentTrade.slPrice.toFixed(2)  + "  (-" + slDistPct + "%)");
        Log("║  PnL     : " + signStr(pnl) + "$" + pnl.toFixed(2));
    } else {
        Log("║  Trade   : No open position");
    }

    Log("╠══════════════════════════════════════════╣");
    Log("║  Balance   : $" + liveBalance.toFixed(2));
    Log("║  Peak Bal  : $" + peakBalance.toFixed(2));
    Log("║  Drawdown  : " + ddStr);
    Log("║  Cooldown  : " + cdStr);
    Log("║  Trades    : " + liveStats.totalTrades +
        " (W:" + liveStats.wins + " / L:" + liveStats.losses + ")");
    Log("╚══════════════════════════════════════════╝");

    if (cooldownUntil > Date.now()) {
        Log("⏳ BOT IN COOLDOWN — " + cdStr);
    }
}

