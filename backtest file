var RISK_PER_TRADE  = 0.02;         // 2% of balance risked per trade

var ADX_PERIOD      = 14;           // ADX period
var ADX_MIN         = 20;           // minimum ADX to enter trade
var ATR_PERIOD      = 14;           // ATR period
var ATR_SL_MULT     = 1.5;          // SL = 1.5 × ATR from entry
var ATR_TP_MULT     = 3.0;          // TP = 3.0 × ATR from entry (R:R = 2:1)

var MAX_DD_PCT      = 0.20;         // 20% max drawdown before cooldown
var COOLDOWN_HOURS  = 12;           // hours to pause after max DD hit
var POLL_MS         = 60000;        // live mode polling interval (ms)

