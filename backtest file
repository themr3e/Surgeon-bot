  - isPositionOpen() checks Amount field, not symbol name
  - Market orders use current price (not -1) for better fill simulation
  - Cooldown map and hourly notifications removed (not useful in backtest)
*/

// =====================================================================
// Backtest Configuration
// =====================================================================
var BACKTEST_SYMBOL      = "BTC_USDT";   // Symbol to test — must match FMZ backtest pair
var INITIAL_CAPITAL      = 500;           // Starting balance (set same value in FMZ backtest config)
var TIMEFRAME            = PERIOD_M15;   // 15-minute candles
var CANDLES_LIMIT        = 201;
var LEVERAGE             = 10;           // Must also be set in FMZ backtest config

var MAX_ORDER_USDT       = 200;
var TP_PCT_LONG          = 1.060;        // +6% take profit for long
var TP_PCT_SHORT         = 0.940;        // -6% take profit for short
var SL_PCT_LONG          = 0.980;        // -2% stop loss for long
var SL_PCT_SHORT         = 1.020;        // +2% stop loss for short
var MAX_TRADE_MINUTES    = 20;
var POSITION_POLL_MS     = 60000;        // 1 candle = 15min; poll every 1 min sim time
var USE_MARKET_BIAS      = true;         // Enable 200 EMA daily bias filter

// =====================================================================
// Global State
// =====================================================================
var currentTrade = null;

var stats = {
    balance:     INITIAL_CAPITAL,
    totalTrades: 0,
    wins:        0,
    losses:      0,
    timeouts:    0,
    totalPnl:    0.0
};

// =====================================================================
// Helpers
// =====================================================================

function floorTo(value, decimals) {
    var factor = Math.pow(10, decimals);
    return Math.floor(value * factor) / factor;
}

function getDecimals(stepSize) {
    if (stepSize >= 1) return 0;
    var s = stepSize.toString();
    var dotIndex = s.indexOf(".");
    if (dotIndex === -1) return 0;
    return s.length - dotIndex - 1;
}

